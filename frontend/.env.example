VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API base. Leave unset to use same-origin /api/v1
# (Vite dev server proxies /api -> VITE_DEV_PROXY_TARGET below; set this to your
#  deployed backend URL like https://medikiosk-backend.onrender.com/api/v1 in prod).
VITE_API_URL=

# Dev-only: where the Vite dev proxy forwards /api and /ws calls.
# Defaults to http://localhost:8000. Set this to your deployed backend if you
# develop against a remote instance (fixes ECONNREFUSED proxy errors).
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Clerk — get from dashboard.clerk.com -> your app -> API Keys (Publishable key, starts with pk_)
VITE_CLERK_PUBLISHABLE_KEY=pk_your_publishable_key

# Bhashini direct Dhruva inference key (optional — kiosk works offline without it)
VITE_BHASHINI_API_KEY=

# Gemini API key for interview AI + translation fallback
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash

# Google Maps JavaScript API key (optional — falls back to keyless iframe embed)
VITE_GOOGLE_MAPS_API_KEY=
