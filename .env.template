# ============================================
# MediKiosk Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# ---- Application ----
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-secret-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medikiosk
POSTGRES_USER=medikiosk
POSTGRES_PASSWORD=medikiosk_dev_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ---- MinIO (S3-compatible object storage) ----
# NOTE: MinIO/Redis/local Postgres are legacy. New deployments use Supabase
# (managed PostgREST + Storage) — see SUPABASE_* below. MinIO can remain for
# local fallback but is not required for production.
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=medikiosk
MINIO_ROOT_PASSWORD=medikiosk_minio_password
MINIO_BUCKET=medikiosk-documents

# ---- Supabase (managed PostgREST + Storage) ----
# Backend uses the SERVICE ROLE key (server-side ONLY). The anon key lives in
# frontend/.env and never grants PHI access. Fill these to activate Supabase;
# leave empty for local/demo graceful-degradation mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=medikiosk-documents

# ---- Clerk (auth — activated when CLERK_ISSUER is set) ----
# Point at your Clerk instance so the backend can verify Clerk-issued JWTs
# against the published JWKS. Frontend needs VITE_CLERK_PUBLISHABLE_KEY too.
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWKS_URL=
CLERK_SECRET_KEY=
# ---- JWT Authentication ----
# Legacy custom JWT. Retained for mock/local auth only (offline/tests). When
# CLERK_ISSUER is set, Clerk JWTs take precedence over these.
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Bhashini ASR (Free - https://bhashini.gov.in) ----
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# ---- Google Gemini (Free tier - https://ai.google.dev) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ---- Google Places (nearby hospital discovery for OPD booking) ----
# Server-side key for the Places Nearby Search proxy (/api/v1/kiosk/nearby-hospitals).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_RADIUS_M=10000

# ---- Notifications (booking confirmations + non-partner outreach) ----
# SMTP for patient email confirmations + hospital outreach emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Medikiosk <no-reply@medikiosk.in>
SMTP_USE_TLS=true
# WhatsApp Business / provider webhook for patient SMS-WhatsApp confirmations.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_PHONE=

# ---- ABDM Sandbox (Free - https://sandbox.abdm.gov.in) ----
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# ---- Google Cloud Vision OCR (Fallback - Free tier 1000 req/month) ----
GOOGLE_CLOUD_VISION_API_KEY=

# ---- Tesseract OCR (Local - Free) ----
TESSERACT_CMD=/usr/bin/tesseract

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json
